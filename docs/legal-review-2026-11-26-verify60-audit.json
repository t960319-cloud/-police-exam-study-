      "issues": [
        {
          "id": "scene115-14",
          "severity": "medium",
          "requiredBeforeApproval": true,
          "reason": "D詳解以「如警械致傷亡」引警械條例10條之2，未明列該條的警察人員使用警械前提。原題是嫌疑人搶走警棍傷害同仁，不能將嫌疑人用械傷人直接涵蓋為本條事件；一般救護義務的結論仍正確。",
          "suggestedFix": "將D詳解後句改為「本題救護係對受襲受傷同仁的緊急保護；若另有警察人員使用警械致現場人員傷亡，條例第10條之2並明定迅速通報救護或送醫及必要保護、戒護。」其餘選項、官方C及trueStatement均不動。",
          "sourceEvidence": {
            "path": "/tmp/police-verify60-correct-weapons-correct.txt",
            "lines": "115–116",
            "url": "https://law.moj.gov.tw/LawClass/LawAll.aspx?pcode=D0080042",
            "actualRule": "第10條之2的主體與要件是警察人員使用警械，致現場人員傷亡。"
          }
        },
        {
          "id": "duty111_13",
          "severity": "low",
          "requiredBeforeApproval": false,
          "reason": "D的警種重組三個列舉未在已引兩份原件逐字出現；原件直接支持的是重組巡邏活動與預警、分權、合作等方向。現稿稱為具體說明尚可，但宜明示是依該理論作涵攝，避免被誤讀為全文逐列此三種勤務。",
          "suggestedFix": "D說明末句可補「此為依該組織策略所作的涵攝，所引原文未逐字列出本項三類警力。」不必重開待核，也不影響C誤用Analysis的確定結論。",
          "sourceEvidence": {
            "paths": [
              "/tmp/police-plus50-duty-scene-npa-mag811.txt",
              "/tmp/police-verify60-duty9-camps-tpa.txt"
            ],
            "locations": [
              "警光811期印刷頁71",
              "警專學報印刷頁221及頁227周邊"
            ],
            "facts": "四大工作要項、Bayley日本考察、CAMPS的Adaptation均有直接原文。"
          }
        }
